<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Requiere D-pad / Leanback, no requiere touchscreen -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".SmartHealthTvApp"
        android:allowBackup="true"
        android:banner="@drawable/banner_tv"
        android:icon="@drawable/ic_launcher_tv"
        android:label="@string/app_name_tv"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartHealthMonitorTV"
        tools:targetApi="31">

        <activity
            android:name=".TVActivity"
            android:exported="true"
            android:banner="@drawable/banner_tv"
            android:icon="@drawable/ic_launcher_tv"
            android:label="@string/app_name_tv"
            android:logo="@drawable/banner_tv"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.SmartHealthMonitorTV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
